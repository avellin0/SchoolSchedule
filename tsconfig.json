{
    "compilerOptions": {
      "target": "ES2023",
      "module": "commonjs",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "baseUrl": "./src",
      "paths": {
        "@back/*": ["Back_End/*"],
        "@front/*": ["Front_End/*"],
        "@components/*": ["Front_End/components/*"]
      }
    }
  }
  